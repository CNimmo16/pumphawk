{
  "name": "@pump-hawk/native",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "check:dependencies": "expo install --check",
    "export:check": "expo export --platform ios --platform android --output-dir dist",
    "update:preview": "EXPO_NO_DOTENV=1 pnpm dlx eas-cli@24.7.0 update --channel preview --environment production",
    "update:production": "EXPO_NO_DOTENV=1 pnpm dlx eas-cli@24.7.0 update --channel production --environment production",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.5",
    "@pump-hawk/openapi": "workspace:*",
    "@pump-hawk/presentation": "workspace:*",
    "@tanstack/react-query": "^5.95.2",
    "babel-preset-expo": "~57.0.12",
    "better-auth": "1.7.5",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.1.0",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.1"
  }
}
