{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pump-hawk-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "services": [{ "binding": "API", "service": "pump-hawk-api" }],
}
