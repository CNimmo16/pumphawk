{
  "name": "@pump-hawk/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --test-scheduled",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "openapi": "node --import tsx scripts/openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/app/app.integration.test.ts",
    "data:sync": "node --import tsx scripts/sync-data.ts",
    "data:watch": "node --import tsx scripts/local-scheduler.ts"
  },
  "dependencies": {
    "@pump-hawk/contracts": "workspace:*",
    "@better-auth/drizzle-adapter": "1.7.5",
    "better-auth": "1.7.5",
    "@hono/zod-openapi": "^1.1.5",
    "@hono/swagger-ui": "^0.5.2",
    "hono": "^4.12.0",
    "drizzle-orm": "1.0.0-rc.4",
    "postgres": "^3.4.8",
    "typed-inject": "^5.0.0",
    "zod": "^4.3.5",
    "libphonenumber-js": "^1.12.24"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "dotenv": "^17.2.0",
    "tsx": "^4.20.3",
    "vitest": "^4.1.1",
    "wrangler": "4.132.0"
  }
}
